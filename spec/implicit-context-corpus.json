{
  "_comment": "ADR-0075 §5 parity corpus. Hand-authored oracle — do NOT regenerate from either matcher. Positions are 0-indexed char offsets, end exclusive. matchedText preserves the input's original casing. Slice 1 = §3 core (longest-match, case-fold, apostrophe-aware boundary). Slice 2 adds possessive/enclitic-attaches, space≡hyphen equivalence (fusion excluded), and a deterministic (length, norm(name), id) tie-break for equal-length collisions (the F1 fix). Case folding (F2) is unchanged: IGNORECASE/`/i` covers common accented letters (e.g. é/É) identically on both sides; the rare fold-divergent characters (Greek final sigma ς/σ, Turkish İ/ı, ß/ẞ) are an accepted known limitation, not guaranteed identical.",
  "cases": [
    { "name": "longest-match wins over overlap",
      "entities": [ {"id":"e_bob","title":"Bob","aliases":[]}, {"id":"e_bobsmith","title":"Bob Smith","aliases":[]} ],
      "text": "Peter greeted Bob Smith warmly.",
      "expected": [ {"id":"e_bobsmith","start":14,"end":23,"matchedText":"Bob Smith"} ] },

    { "name": "shorter name alone still matches",
      "entities": [ {"id":"e_bob","title":"Bob","aliases":[]}, {"id":"e_bobsmith","title":"Bob Smith","aliases":[]} ],
      "text": "Bob went home.",
      "expected": [ {"id":"e_bob","start":0,"end":3,"matchedText":"Bob"} ] },

    { "name": "case-insensitive match, original-casing render",
      "entities": [ {"id":"e_bobsmith","title":"Bob Smith","aliases":[]} ],
      "text": "i saw BOB SMITH today",
      "expected": [ {"id":"e_bobsmith","start":6,"end":15,"matchedText":"BOB SMITH"} ] },

    { "name": "substring inside a larger word does not match (boundary)",
      "entities": [ {"id":"e_ana","title":"Ana","aliases":[]} ],
      "text": "Banana bread",
      "expected": [] },

    { "name": "alias matches",
      "entities": [ {"id":"e_rob","title":"Robert","aliases":["Bobby"]} ],
      "text": "Bobby waved.",
      "expected": [ {"id":"e_rob","start":0,"end":5,"matchedText":"Bobby"} ] },

    { "name": "apostrophe inside a token blocks a sub-name (O'Brien does not yield Brien)",
      "entities": [ {"id":"e_brien","title":"Brien","aliases":[]} ],
      "text": "O'Brien arrived.",
      "expected": [] },

    { "name": "a name containing an internal apostrophe matches as a whole",
      "entities": [ {"id":"e_obrien","title":"O'Brien","aliases":[]} ],
      "text": "O'Brien arrived.",
      "expected": [ {"id":"e_obrien","start":0,"end":7,"matchedText":"O'Brien"} ] },

    { "name": "single-word name matches across a hyphen boundary (stable both slices)",
      "entities": [ {"id":"e_warrior","title":"Warrior","aliases":[]} ],
      "text": "the code-warrior fought",
      "expected": [ {"id":"e_warrior","start":9,"end":16,"matchedText":"warrior"} ] },

    { "name": "multi-word name adjacent to punctuation matches",
      "entities": [ {"id":"e_bobsmith","title":"Bob Smith","aliases":[]} ],
      "text": "(Bob Smith)",
      "expected": [ {"id":"e_bobsmith","start":1,"end":10,"matchedText":"Bob Smith"} ] },

    { "name": "two separate hits in one text, in order",
      "entities": [ {"id":"e_bob","title":"Bob","aliases":[]}, {"id":"e_alice","title":"Alice","aliases":[]} ],
      "text": "Bob met Alice.",
      "expected": [ {"id":"e_bob","start":0,"end":3,"matchedText":"Bob"}, {"id":"e_alice","start":8,"end":13,"matchedText":"Alice"} ] },

    { "name": "unicode adjacency — matches whole word",
      "entities": [ {"id":"e_zoe","title":"Zoë","aliases":[]} ],
      "text": "Zoë waved",
      "expected": [ {"id":"e_zoe","start":0,"end":3,"matchedText":"Zoë"} ] },

    { "name": "unicode — a longer word is not a match",
      "entities": [ {"id":"e_zoe","title":"Zoë","aliases":[]} ],
      "text": "Zoëlle danced",
      "expected": [] },

    { "name": "possessive 's attaches to the base name",
      "entities": [ {"id":"e_bob","title":"Bob","aliases":[]} ],
      "text": "Peter visited Bob's place.",
      "expected": [ {"id":"e_bob","start":14,"end":17,"matchedText":"Bob"} ] },

    { "name": "plural lone-apostrophe possessive attaches",
      "entities": [ {"id":"e_smiths","title":"Smiths","aliases":[]} ],
      "text": "the Smiths' car",
      "expected": [ {"id":"e_smiths","start":4,"end":10,"matchedText":"Smiths"} ] },

    { "name": "possessive-containing entity outranks base name (maximal munch)",
      "entities": [ {"id":"e_bob","title":"Bob","aliases":[]}, {"id":"e_house","title":"Bob's house","aliases":[]} ],
      "text": "Peter walked to Bob's House.",
      "expected": [ {"id":"e_house","start":16,"end":27,"matchedText":"Bob's House"} ] },

    { "name": "space≡hyphen: multi-word entity matches hyphenated prose",
      "entities": [ {"id":"e_cw","title":"Code Warrior","aliases":[]} ],
      "text": "the code-warrior fought",
      "expected": [ {"id":"e_cw","start":4,"end":16,"matchedText":"code-warrior"} ] },

    { "name": "space≡hyphen: multi-word beats single word by maximal munch",
      "entities": [ {"id":"e_cw","title":"Code Warrior","aliases":[]}, {"id":"e_w","title":"Warrior","aliases":[]} ],
      "text": "the code-warrior fought",
      "expected": [ {"id":"e_cw","start":4,"end":16,"matchedText":"code-warrior"} ] },

    { "name": "fused spelling does not match without an alias",
      "entities": [ {"id":"e_cw","title":"Code Warrior","aliases":[]} ],
      "text": "the codewarrior fought",
      "expected": [] },

    { "name": "cross-entity shared alias resolves to lowest id regardless of input order (F1)",
      "entities": [ {"id":"e_bob","title":"Bob","aliases":["Kid"]}, {"id":"e_alice","title":"Alice","aliases":["Kid"]} ],
      "text": "the Kid ran",
      "expected": [ {"id":"e_alice","start":4,"end":7,"matchedText":"Kid"} ] },

    { "name": "accented name matches case-insensitively (parity-safe non-ASCII)",
      "entities": [ {"id":"e_zoe2","title":"Zoé","aliases":[]} ],
      "text": "ZOÉ waved",
      "expected": [ {"id":"e_zoe2","start":0,"end":3,"matchedText":"ZOÉ"} ] }
  ]
}
