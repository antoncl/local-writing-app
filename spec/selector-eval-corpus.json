{
  "_comment": "Cross-runtime parity corpus for the context-pick selector evaluator (ADR-0074 slice 5 / ADR-0082 slice 2b). The SAME cases are run by backend/tests/test_selector_eval_parity.py (Python: evaluate_selector_membership) and frontend/src/lib/views/selectorEvalParity.test.ts (TypeScript: evaluateView). Both must return `expected` verbatim. `expected` is in node-array (roster) order, deduped. A change to either evaluator that breaks parity turns its runtime's gate red. `tagged` names a tag NODE by id and matches when that id appears anywhere in a node's metadata (any field, any depth) — schema-free, not keyed to a conventional `tags` field; the `schema.entry_types[*].parent` chain drives type/descendants_of.",
  "schema": {
    "entry_types": {
      "lore:base": {},
      "lore:note": { "parent": "lore:base" },
      "lore:location": { "parent": "lore:base" },
      "lore:character": { "parent": "lore:base" },
      "lore:hero": { "parent": "lore:character" },
      "plot:base": {},
      "plot:card": { "parent": "plot:base" }
    }
  },
  "cases": [
    {
      "name": "bare tagged selects every tag bearer",
      "expr": { "tagged": "tag_world_building" },
      "nodes": [
        { "id": "a", "entry_type": "lore:note", "metadata": { "tags": ["tag_world_building"] } },
        { "id": "b", "entry_type": "lore:note", "metadata": { "tags": [] } },
        { "id": "c", "entry_type": "lore:location", "metadata": { "tags": ["tag_world_building", "tag_real_world"] } }
      ],
      "expected": ["a", "c"]
    },
    {
      "name": "tag intersect type-union is the picker shape",
      "expr": {
        "intersect": [
          { "tagged": "tag_world_building" },
          { "union": [{ "type": "lore:note" }, { "type": "lore:location" }] }
        ]
      },
      "nodes": [
        { "id": "note", "entry_type": "lore:note", "metadata": { "tags": ["tag_world_building"] } },
        { "id": "loc", "entry_type": "lore:location", "metadata": { "tags": ["tag_world_building"] } },
        { "id": "wrongtag", "entry_type": "lore:note", "metadata": { "tags": ["tag_real_world"] } },
        { "id": "wrongtype", "entry_type": "lore:character", "metadata": { "tags": ["tag_world_building"] } }
      ],
      "expected": ["note", "loc"]
    },
    {
      "name": "type is exact, not subtype",
      "expr": { "type": "lore:character" },
      "nodes": [
        { "id": "hero", "entry_type": "lore:hero", "metadata": {} },
        { "id": "char", "entry_type": "lore:character", "metadata": {} }
      ],
      "expected": ["char"]
    },
    {
      "name": "descendants_of includes subtypes",
      "expr": { "descendants_of": "lore:character" },
      "nodes": [
        { "id": "hero", "entry_type": "lore:hero", "metadata": {} },
        { "id": "char", "entry_type": "lore:character", "metadata": {} },
        { "id": "note", "entry_type": "lore:note", "metadata": {} }
      ],
      "expected": ["hero", "char"]
    },
    {
      "name": "tagged matches through a user vocabulary field",
      "expr": { "tagged": "tag_motif_a" },
      "nodes": [
        { "id": "a", "entry_type": "lore:note", "metadata": { "motifs": ["tag_motif_a"] } },
        { "id": "b", "entry_type": "lore:note", "metadata": { "motifs": ["tag_motif_b"] } }
      ],
      "expected": ["a"]
    },
    {
      "name": "tagged matches a nested item-group member",
      "expr": { "tagged": "tag_nested_x" },
      "nodes": [
        { "id": "a", "entry_type": "lore:note", "metadata": { "cast": [{ "name": "Nyla", "role_tag": "tag_nested_x" }] } },
        { "id": "b", "entry_type": "lore:note", "metadata": { "cast": [{ "name": "Rook", "role_tag": "tag_other" }] } }
      ],
      "expected": ["a"]
    },
    {
      "name": "an id present only as a substring does not match",
      "expr": { "tagged": "tag_x" },
      "nodes": [
        { "id": "a", "entry_type": "lore:note", "metadata": { "notes": "tag_x_extended" } }
      ],
      "expected": []
    },
    {
      "name": "difference keep minus remove",
      "expr": {
        "difference": { "keep": { "tagged": "tag_t" }, "remove": { "type": "lore:location" } }
      },
      "nodes": [
        { "id": "a", "entry_type": "lore:note", "metadata": { "tags": ["tag_t"] } },
        { "id": "b", "entry_type": "lore:location", "metadata": { "tags": ["tag_t"] } }
      ],
      "expected": ["a"]
    },
    {
      "name": "complement is universe minus inner",
      "expr": { "complement": { "tagged": "tag_t" } },
      "nodes": [
        { "id": "a", "entry_type": "lore:note", "metadata": { "tags": ["tag_t"] } },
        { "id": "b", "entry_type": "lore:note", "metadata": { "tags": [] } }
      ],
      "expected": ["b"]
    },
    {
      "name": "union dedups and follows roster order",
      "expr": { "union": [{ "tagged": "tag_t" }, { "type": "lore:note" }] },
      "nodes": [
        { "id": "a", "entry_type": "lore:note", "metadata": { "tags": ["tag_t"] } },
        { "id": "b", "entry_type": "lore:note", "metadata": { "tags": ["tag_t"] } }
      ],
      "expected": ["a", "b"]
    },
    {
      "name": "filter keep lowers to intersect",
      "expr": { "filter": { "of": { "tagged": "tag_t" }, "pred": { "type": "lore:note" } } },
      "nodes": [
        { "id": "a", "entry_type": "lore:note", "metadata": { "tags": ["tag_t"] } },
        { "id": "b", "entry_type": "lore:location", "metadata": { "tags": ["tag_t"] } }
      ],
      "expected": ["a"]
    },
    {
      "name": "filter drop lowers to difference",
      "expr": {
        "filter": { "of": { "tagged": "tag_t" }, "pred": { "type": "lore:note" }, "mode": "drop" }
      },
      "nodes": [
        { "id": "a", "entry_type": "lore:note", "metadata": { "tags": ["tag_t"] } },
        { "id": "b", "entry_type": "lore:location", "metadata": { "tags": ["tag_t"] } }
      ],
      "expected": ["b"]
    },
    {
      "name": "field overlap on a list value is the plotline shape",
      "expr": {
        "intersect": [
          { "type": "plot:card" },
          { "field": { "key": "plotline", "op": "overlap", "value": "pl_1" } }
        ]
      },
      "nodes": [
        { "id": "c1", "entry_type": "plot:card", "metadata": { "plotline": ["pl_1", "pl_2"] } },
        { "id": "c2", "entry_type": "plot:card", "metadata": { "plotline": ["pl_3"] } }
      ],
      "expected": ["c1"]
    },
    {
      "name": "field overlap on a scalar value is whole-value equality",
      "expr": { "field": { "key": "pov", "op": "overlap", "value": "Bob" } },
      "nodes": [
        { "id": "a", "entry_type": "lore:note", "metadata": { "pov": "Bob" } },
        { "id": "b", "entry_type": "lore:note", "metadata": { "pov": "Bobby" } }
      ],
      "expected": ["a"]
    },
    {
      "name": "field set and unset",
      "expr": { "field": { "key": "pov", "op": "set" } },
      "nodes": [
        { "id": "a", "entry_type": "lore:note", "metadata": { "pov": "Bob" } },
        { "id": "b", "entry_type": "lore:note", "metadata": { "pov": "" } },
        { "id": "c", "entry_type": "lore:note", "metadata": {} }
      ],
      "expected": ["a"]
    },
    {
      "name": "empty expr selects nothing (ADR-0036)",
      "expr": {},
      "nodes": [{ "id": "a", "entry_type": "lore:note", "metadata": { "tags": ["tag_t"] } }],
      "expected": []
    },
    {
      "name": "hand_picked selects by id",
      "expr": { "hand_picked": ["b", "missing"] },
      "nodes": [
        { "id": "a", "entry_type": "lore:note", "metadata": {} },
        { "id": "b", "entry_type": "lore:note", "metadata": {} }
      ],
      "expected": ["b"]
    }
  ]
}
